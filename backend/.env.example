# backend/.env — copy to .env and adjust. Loaded when running commands from backend/.
# See backend/app/config.py for active variables. Plan: plan/database-setup/
#
# Switch database by changing DATABASE_URL only — same commands work for worker, API, and Alembic:
#   uv run python -m app.worker --init-db
#   uv run python -m app.worker --sync --max-pages 2
#   uv run uvicorn app.main:app --reload --port 8000
#   uv run alembic upgrade head          # after Alembic is configured (Phase 1.2)
#
# Run all commands from backend/ so this file is found. Restart uvicorn after changing DATABASE_URL.

# =============================================================================
# Database (pick one — comment/uncomment or replace the active line)
# =============================================================================

# SQLite — default local POC; no Docker required
DATABASE_URL=sqlite:///./jobportal.db

# Postgres — requires: docker compose up -d (from repo root)
# Credentials must match docker-compose.yml (or root .env for Docker)
# DATABASE_URL=postgresql+psycopg2://jobportal:jobportal@localhost:5432/jobportal

# =============================================================================
# Core
# =============================================================================
CORS_ORIGINS=http://localhost:5173
SYNC_CRON_SCHEDULE=0 2 * * *

# =============================================================================
# Job source adapters (set *_ENABLED=false to skip sync)
# =============================================================================
MCF_ENABLED=true
JOBICY_ENABLED=true
ADZUNA_ENABLED=true
LINKEDIN_ENABLED=true

# =============================================================================
# Sync page sizes (jobs fetched per API page during --sync)
# =============================================================================
MCF_PAGE_SIZE=100
ADZUNA_PAGE_SIZE=50
JOBICY_PAGE_SIZE=200
LINKEDIN_PAGE_SIZE=70

# =============================================================================
# MyCareersFuture (Singapore gov API, no API key)
# =============================================================================
# Future: MCF_BASE_URL, search filters, etc.

# =============================================================================
# Jobicy (remote jobs, no API key) — https://jobicy.com/jobs-rss-feed
# =============================================================================
# JOBICY_GEO=singapore
# JOBICY_INDUSTRY=engineering
# JOBICY_TAG=python

# =============================================================================
# Adzuna (Singapore listings) — free API key at https://developer.adzuna.com
# =============================================================================
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Future: ADZUNA_WHAT=, ADZUNA_WHERE=

# =============================================================================
# LinkedIn (self-hosted scraper) — https://github.com/atharv01h/Linkedin-Jobs-Api
# =============================================================================
# Run the Node service first (default http://localhost:3000). Set LINKEDIN_JOBS_API_URL= to disable.
LINKEDIN_JOBS_API_URL=http://localhost:3000/api/v1
LINKEDIN_LOCATION=Singapore
# LINKEDIN_KEYWORDS=software engineer
# LINKEDIN_DATE_SINCE_POSTED=past_week

# =============================================================================
# Authentication (Phase 2 — not wired in config.py yet)
# =============================================================================
# JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-base64-32
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=60

# =============================================================================
# Docker Postgres (repo root — for docker compose only, not read by FastAPI)
# =============================================================================
# Copy to repo root .env when running docker compose. Must match DATABASE_URL above.
# POSTGRES_USER=jobportal
# POSTGRES_PASSWORD=jobportal
# POSTGRES_DB=jobportal
