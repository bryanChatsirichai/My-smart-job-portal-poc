# Compose-only variables — not read by FastAPI.
# Copy to .env before first run: cp .env.example .env
#
# Must stay in sync with DATABASE_URL in backend/.env when using Postgres:
#   postgresql+psycopg2://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_HOST_PORT>/<POSTGRES_DB>

POSTGRES_USER=jobportal
POSTGRES_PASSWORD=jobportal
POSTGRES_DB=jobportal

# Host port mapped to container 5432. Change if 5432 is already in use locally.
POSTGRES_HOST_PORT=5432
