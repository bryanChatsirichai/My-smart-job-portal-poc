# .env.example
DATABASE_URL=sqlite:///./jobportal.db
CORS_ORIGINS=http://localhost:5173
SYNC_CRON_SCHEDULE=0 2 * * *
VITE_API_BASE_URL=http://localhost:8000

# Adzuna (second job source) — free API key at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jobicy (remote jobs) — no API key; optional filters: https://jobicy.com/jobs-rss-feed
# JOBICY_GEO=singapore
# JOBICY_INDUSTRY=engineering
# JOBICY_TAG=python

# Future: use Postgres via docker-compose.yml, then uncomment:
# DATABASE_URL=postgresql+psycopg2://jobportal:jobportal@localhost:5432/jobportal
