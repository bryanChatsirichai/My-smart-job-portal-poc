# .env.example
DATABASE_URL=sqlite:///./jobportal.db
CORS_ORIGINS=http://localhost:5173
SYNC_CRON_SCHEDULE=0 2 * * *
VITE_API_BASE_URL=http://localhost:8000

# Adzuna (second job source) — free API key at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jobicy (remote jobs) — no API key; optional filters: https://jobicy.com/jobs-rss-feed
# JOBICY_GEO=singapore
# JOBICY_INDUSTRY=engineering
# JOBICY_TAG=python

# LinkedIn (self-hosted scraper API) — https://github.com/atharv01h/Linkedin-Jobs-Api
# Run the Node service first: npm run dev --workspace=backend (default http://localhost:3000)
# Defaults: LINKEDIN_JOBS_API_URL=http://localhost:3000/api/v1, LINKEDIN_LOCATION=Singapore
# Set LINKEDIN_JOBS_API_URL= to disable the adapter
# LINKEDIN_KEYWORDS=software engineer
# LINKEDIN_DATE_SINCE_POSTED=past_week

# Future: use Postgres via docker-compose.yml, then uncomment:
# DATABASE_URL=postgresql+psycopg2://jobportal:jobportal@localhost:5432/jobportal
